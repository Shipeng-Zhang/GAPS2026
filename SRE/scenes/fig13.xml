<scene version="2.1.0">

<!-- Defaults, these can be set via the command line: -Darg=value -->

	<default name="spp" value="128"/>
	<default name="res" value="960"/>
	<default name="max_depth" value="4"/>
	<default name="integrator" value="sre_cuda"/>
	<default name="style_config" value="../configs/f13_tone.json"/>

<!-- Camera and Rendering Parameters -->

	<integrator type="$integrator" id="fig13-sre" name="fig13-sre">
		<integer name="max_depth" value="$max_depth"/>
		<integer name="rr_depth" value="4"/>
		<float name="rr_probability" value="0.95"/>
		<string name="style_config" value="$style_config"/>
	</integrator>
	<sensor type="thinlens" id="Camera" name="Camera">
		<string name="fov_axis" value="x"/>
		<!-- The paper main views are 1920x1080.  A slightly tighter horizontal
		     crop matches the published robot occupancy in that 16:9 frame. -->
		<float name="fov" value="79.0"/>
		<float name="near_clip" value="0.100000"/>
		<float name="far_clip" value="100.000000"/>
		<!-- Focus the main robot while allowing the floor pattern and curved
		     reflection to acquire the gradual distribution blur in Fig. 13. -->
		<float name="focus_distance" value="15.0"/>
		<!-- Fig. 13's left half is the purely specular render.  Keep the camera
		     pinhole here so the flat-mirror reflection remains sharp; the right
		     curved reflector is still softened by its GGX distribution. -->
		<float name="aperture_radius" value="0.0"/>
		<transform name="to_world">
			<rotate x="1" angle="-163.1564579873814"/>
			<rotate y="1" angle="-49.28376954117144"/>
			<rotate z="1" angle="178.77521548698965"/>
			<translate value="12.315414 5.396643 12.884549"/>
		</transform>
		<sampler type="independent" name="sampler">
			<integer name="sample_count" value="$spp"/>
		</sampler>
		<film type="hdrfilm" name="film">
			<integer name="width" value="$res"/>
			<integer name="height" value="$res"/>
			<rfilter type="box"/>
			<string name="pixel_format" value="rgb"/>
			<string name="component_format" value="float32"/>
		</film>
	</sensor>

<!-- Materials -->

	<bsdf type="twosided" id="mat-Material.001" name="mat-Material.001">
		<!-- Paper-white diffuse base plus a restrained polished clear coat.
		     The 35% GGX branch carries a readable robot reflection, while the
		     roughness creates the transport-driven softening shown in Fig. 13. -->
		<bsdf type="blendbsdf">
			<float name="weight" value="0.35"/>
			<bsdf type="diffuse">
				<rgb value="0.80, 0.80, 0.80" name="reflectance"/>
			</bsdf>
			<bsdf type="roughconductor">
				<string name="distribution" value="ggx"/>
				<float name="alpha" value="0.030"/>
				<string name="material" value="none"/>
				<rgb value="0.90, 0.90, 0.90" name="specular_reflectance"/>
			</bsdf>
		</bsdf>
	</bsdf>
	<bsdf type="twosided" id="default-bsdf" name="default-bsdf">
		<bsdf type="diffuse" name="bsdf"/>
	</bsdf>
	<bsdf type="diffuse" id="mat-Material" name="mat-Material">
		<rgb value="0.800000 0.800000 0.800000" name="reflectance"/>
	</bsdf>
	<!-- Fig. 13: left is a perfect planar mirror; right is the curved GGX
	     reflector whose distribution should blur tone through transport. -->
	<bsdf type="twosided" id="mat-f13-planar-mirror">
		<!-- Blender exported this thin mirror with the geometric normal facing
		     away from the camera. A two-sided wrapper preserves the same ideal
		     delta reflection on the visible side instead of showing its back. -->
		<bsdf type="conductor">
			<string name="material" value="none"/>
			<rgb name="specular_reflectance" value="0.99, 0.99, 0.99"/>
		</bsdf>
	</bsdf>
	<bsdf type="twosided" id="mat-f13-glossy-mirror">
		<!-- The curved reflector is visible both directly and through the
		     planar mirror.  Its exported winding exposes opposite sides in
		     those two views, so a one-sided conductor made the reflected side
		     an artificial solid-black disk. -->
		<bsdf type="roughconductor">
			<string name="distribution" value="ggx"/>
			<!-- The source reflector has only 960 triangles.  Smooth normals below
			     provide the curved macro surface; a small nonzero GGX width retains
			     the paper's distributional path without erasing the reflected robot. -->
			<!-- A small but visible GGX spread keeps the robot legible while
			     naturally softening the stylized reflection on the sphere. -->
			<float name="alpha" value="0.012"/>
			<string name="material" value="none"/>
			<rgb name="specular_reflectance" value="0.97, 0.97, 0.97"/>
		</bsdf>
	</bsdf>

<!-- Emitters -->

	<emitter type="constant" id="World" name="World">
		<!-- Paper-white studio surround used by Fig. 13. -->
		<rgb value="0.800000 0.800000 0.800000" name="radiance"/>
	</emitter>
	<emitter type="directional" id="emit-Lamp" name="emit-Lamp">
		<rgb value="0.550000 0.550000 0.550000" name="irradiance"/>
		<transform name="to_world">
			<matrix value="0.671683 0.600998 -0.433178 7.059191 -0.372875 -0.230998 -0.898668 13.497950 -0.640161 0.765141 0.068939 2.657435 0.000000 0.000000 0.000000 1.000000"/>
		</transform>
	</emitter>

