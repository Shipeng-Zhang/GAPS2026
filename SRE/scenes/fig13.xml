	<shape type="ply" id="mesh-f13-planar-reflector" name="mesh-f13-planar-reflector">
		<!-- ASCII alias keeps the paper asset portable across Mitsuba builds
		     whose filesystem codec cannot open the original Chinese filename. -->
		<string name="filename" value="fig13_meshes/meshes/planar_reflector.ply"/>
		<boolean name="face_normals" value="true"/>
		<!-- The reflector and camera were exported in one world coordinate
		     system, but the published arrangement moves the reflector forward
		     and scales its visible rectangle.  Translation along its normal is
		     calibrated so the reflected robot occupies the far-left third rather
		     than overlapping the directly viewed robot. -->
		<transform name="to_world">
