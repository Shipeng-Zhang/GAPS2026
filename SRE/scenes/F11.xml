<scene version="3.0.0">
    <default name="spp" value="256"/>
    <default name="res" value="640"/>
    <default name="max_depth" value="4"/>
    <default name="integrator" value="sre_cuda"/>
    <default name="style_config" value="../configs/f11_lines.json"/>

    <integrator type="$integrator">
        <integer name="max_depth" value="$max_depth"/>
        <integer name="rr_depth" value="4"/>
        <float name="rr_probability" value="0.95"/>
        <string name="style_config" value="$style_config"/>
    </integrator>

    <!-- The paper's Fig. 11 is a 3:1 horizontal lineup on a black stage. -->
    <sensor type="perspective" id="f11-camera">
        <string name="fov_axis" value="x"/>
        <float name="fov" value="64"/>
        <transform name="to_world">
            <lookat origin="0, 3.55, 16.5" target="0, 2.05, 0" up="0, 1, 0"/>
        </transform>
        <sampler type="independent">
            <integer name="sample_count" value="$spp"/>
        </sampler>
        <film type="hdrfilm">
            <integer name="width" value="$res"/>
            <integer name="height" value="$res"/>
            <rfilter type="box"/>
            <string name="pixel_format" value="rgb"/>
            <string name="component_format" value="float32"/>
        </film>
    </sensor>

    <bsdf type="diffuse" id="mat-f11-blue">
        <rgb name="reflectance" value="0.781, 0.781, 0.781"/>
    </bsdf>
    <bsdf type="diffuse" id="mat-f11-purple">
        <rgb name="reflectance" value="0.773, 0.773, 0.773"/>
    </bsdf>
    <bsdf type="diffuse" id="mat-f11-magenta">
        <rgb name="reflectance" value="0.765, 0.765, 0.765"/>
    </bsdf>
    <bsdf type="diffuse" id="mat-f11-pink">
        <rgb name="reflectance" value="0.757, 0.757, 0.757"/>
    </bsdf>
    <bsdf type="diffuse" id="mat-f11-red">
        <rgb name="reflectance" value="0.72, 0.72, 0.72"/>
    </bsdf>
    <bsdf type="roughconductor" id="mat-f11-floor">
        <string name="distribution" value="ggx"/>
        <!-- Fig. 11 uses broad, transport-blurred colored reflections. -->
        <float name="alpha" value="0.145"/>
        <string name="material" value="none"/>
        <rgb name="specular_reflectance" value="0.94, 0.94, 0.94"/>
    </bsdf>

    <!-- Very weak frontal illumination keeps CrossHatch tone responsive while
         avoiding the broad gray floor highlight absent from the paper. -->
    <shape type="rectangle" id="f11-key-light">
        <transform name="to_world">
            <scale x="4.0" y="2.0"/>
            <lookat origin="1.5, 9.0, 8.0" target="0, 2.0, 0" up="0, 1, 0"/>
        </transform>
        <emitter type="area">
            <rgb name="radiance" value="0.22, 0.22, 0.22"/>
        </emitter>
    </shape>

    <shape type="rectangle" id="f11-reflective-floor">
        <transform name="to_world">
            <scale x="12.0" y="6.0"/>
            <rotate x="1" angle="-90"/>
            <translate y="-0.015" z="0.8"/>
        </transform>
        <ref id="mat-f11-floor"/>
    </shape>

    <!-- 1. Compact camera robot: two overlaid blue/cyan feature-line families. -->
    <shape type="cube" id="blue-head">
        <transform name="to_world"><scale x="1.0" y="0.66" z="0.55"/><translate x="-8.0" y="2.72"/></transform>
        <ref id="mat-f11-blue"/>
    </shape>
    <shape type="cylinder" id="blue-lens-rim">
        <point name="p0" x="-8.0" y="2.72" z="0.54"/><point name="p1" x="-8.0" y="2.72" z="0.96"/><float name="radius" value="0.43"/><ref id="mat-f11-blue"/>
    </shape>
    <shape type="cylinder" id="blue-lens-inner">
        <point name="p0" x="-8.0" y="2.72" z="0.95"/><point name="p1" x="-8.0" y="2.72" z="1.02"/><float name="radius" value="0.25"/><ref id="mat-f11-blue"/>
    </shape>
    <shape type="cube" id="blue-neck">
        <transform name="to_world"><scale x="0.22" y="0.22" z="0.25"/><translate x="-8.0" y="1.95"/></transform><ref id="mat-f11-blue"/>
    </shape>
    <shape type="cube" id="blue-torso">
        <transform name="to_world"><scale x="0.62" y="0.48" z="0.48"/><translate x="-8.0" y="1.38"/></transform><ref id="mat-f11-blue"/>
    </shape>
    <shape type="cylinder" id="blue-arm-left">
        <point name="p0" x="-8.48" y="1.45" z="0"/><point name="p1" x="-9.08" y="0.72" z="0.04"/><float name="radius" value="0.18"/><ref id="mat-f11-blue"/>
    </shape>
    <shape type="cylinder" id="blue-arm-right">
        <point name="p0" x="-7.52" y="1.45" z="0"/><point name="p1" x="-6.92" y="0.72" z="0.04"/><float name="radius" value="0.18"/><ref id="mat-f11-blue"/>
    </shape>
    <shape type="sphere" id="blue-joint-left"><point name="center" x="-8.5" y="1.46" z="0"/><float name="radius" value="0.27"/><ref id="mat-f11-blue"/></shape>
    <shape type="sphere" id="blue-joint-right"><point name="center" x="-7.5" y="1.46" z="0"/><float name="radius" value="0.27"/><ref id="mat-f11-blue"/></shape>
    <shape type="cylinder" id="blue-foot-left"><point name="p0" x="-9.08" y="0.72" z="0.04"/><point name="p1" x="-9.08" y="0.25" z="0.18"/><float name="radius" value="0.23"/><ref id="mat-f11-blue"/></shape>
    <shape type="cylinder" id="blue-foot-right"><point name="p0" x="-6.92" y="0.72" z="0.04"/><point name="p1" x="-6.92" y="0.25" z="0.18"/><float name="radius" value="0.23"/><ref id="mat-f11-blue"/></shape>
    <!-- Extra panels/joints approximate the source model's line-producing detail. -->
    <shape type="cube" id="blue-head-top"><transform name="to_world"><scale x="0.62" y="0.10" z="0.60"/><translate x="-8.10" y="3.43"/></transform><ref id="mat-f11-blue"/></shape>
    <shape type="cube" id="blue-head-side"><transform name="to_world"><scale x="0.16" y="0.46" z="0.62"/><rotate z="1" angle="-12"/><translate x="-6.93" y="2.69"/></transform><ref id="mat-f11-blue"/></shape>
    <shape type="sphere" id="blue-elbow-left"><point name="center" x="-8.83" y="1.02" z="0.05"/><float name="radius" value="0.20"/><ref id="mat-f11-blue"/></shape>
    <shape type="sphere" id="blue-elbow-right"><point name="center" x="-7.17" y="1.02" z="0.05"/><float name="radius" value="0.20"/><ref id="mat-f11-blue"/></shape>
    <shape type="cube" id="blue-chest-panel"><transform name="to_world"><scale x="0.40" y="0.25" z="0.08"/><translate x="-8.0" y="1.42" z="0.54"/></transform><ref id="mat-f11-blue"/></shape>

