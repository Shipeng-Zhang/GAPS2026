    <shape type="cylinder" id="magenta-arm-right"><point name="p0" x="0.52" y="1.5" z="0"/><point name="p1" x="1.45" y="0.78" z="0.08"/><float name="radius" value="0.25"/><ref id="mat-f11-magenta"/></shape>
