{
  "metadata": {
    "description": "Lifting Lines and Tone Fig. 1 Wasteland teaser: geometric-normal feature lines plus canonical MLS tone hatching",
    "fig1_evidence": "The teaser demonstrates four transport effects from its caption: DoF-blurred lines/tone (yellow), glossy-reflection blur (red), image-space tone structure in curved reflection (blue), and van hatching responding to the sitting robot's physical reflection (green).",
    "paper_parameters": "Section 4 and Supplemental S1: 16 auxiliary paths and 16 extremal finite-difference searches. Section 5 and Supplemental S2: material-independent mirror anchors, incoming-direction chart, compatible-prefix lookup and local linear MLS inverse. Section 6.3: separate brightness-level functions on emission and reflected lighting, with foreground lift and background attenuation.",
    "tone_bands": "Paper SRE mapping: reflected mean RGB is quantized to target brightness [0.18, 0.39, 0.68]. ToneHatch then selects zero/one/two families by darkness; non-stroke pixels remain paper white, exactly as Supplemental S5.6 specifies. Minimum coverage is deliberately nonzero so the middle band remains visible at 4K.",
    "usage": "CUDA_VISIBLE_DEVICES=0 python ./sre/render.py --scene ./scenes/sre_LLaT.xml --config ./configs/llat_feature_lines.json --width 3840 --height 2160 --spp 32 --spp-per-pass 1 --max-depth 4",
    "paper_composition": "The PDF embeds Fig. 1 as a 3240x1080 publication strip, but changing this horizontal-FOV camera directly to 3:1 clips the robot heads. Render the full 16:9 scene for transport correctness and crop/lay out the final publication strip separately.",
    "cuda_max_wavefront_size": 4096
  },
